# --- build outputs (regenerate with build_iqtree_gpu.sh) ---
iqtree3_gpu_build/
iqtree3_build/
.iqtree3_src/
build_graphs/
*.o
*.so
core.*

# --- cluster logs and job scratch ---
# '/*' rather than a bare directory rule: git cannot re-include a file inside an excluded
# directory, and logs/.gitkeep must stay tracked because slurmd opens a job's -o/-e file before
# the batch script can create the directory.
logs/*
!logs/.gitkeep
*.log
*.err

# --- python caches, editor and OS cruft ---
**/__pycache__/
*.pyc
.DS_Store
*.swp
/.quarto/
**/*.quarto_ipynb

# --- per-user site configuration (config/site.env.example is the tracked fallback) ---
config/site.env

# --- user-generated output from the worked example (expected_output/ IS tracked) ---
examples/out/

# --- transient per-run scratch from the benchmark (benchmark/runs/) and validation (validation/) harnesses ---
# Produced fresh by every run (nvidia-smi samples, wall-clock stamps, raw stdout). Only the
# aggregated RESULT.tsv and the equivalence summaries are worth keeping.
*.util
*.wall
*.time
*.sitelh
benchmark/runs/gpu_validation/
benchmark/runs/gpu_engagement/
validation/differential/
benchmark/runs/_snapshots/
benchmark/runs/_archived_pre_mtgpu_*/
benchmark/runs/matrix/*/
# raw Nsight Systems profiles exceed 100 MB; the reduced summary TSV is tracked
benchmark/profiling/*.nsys-rep

# --- bulky IQ-TREE per-run intermediates ---
# Each benchmark cell (benchmark/runs/paired/<cell>/) keeps RESULT.tsv, PHASES.tsv, equivalence.kv, both arms' trees, .iqtree
# reports and run logs; everything regenerable is dropped.
benchmark/runs/**/*.ckp.gz
benchmark/runs/**/*.ufboot
benchmark/runs/**/*.splits.nex
benchmark/runs/**/*.contree
benchmark/runs/**/*.model.gz
benchmark/runs/**/*.mldist
benchmark/runs/**/*.bionj
benchmark/runs/**/*.stdout
benchmark/runs/**/*.parstree
benchmark/runs/**/*.treefile
benchmark/runs/**/*.iqtree
benchmark/runs/**/*.uniqueseq.phy
benchmark/runs/**/core.*
!benchmark/runs/paired/**/*.treefile
!benchmark/runs/paired/**/*.iqtree
!benchmark/runs/paired/**/*.contree
!benchmark/runs/paired/**/*.log
!validation/equivalence/**

# --- benchmark input data: the payloads live on Zenodo (doi:10.5281/zenodo.22942159), not in git ---
# benchmark/scripts/fetch_benchmark_data.sh downloads them into place; the metadata, provenance,
# checksums, guide trees and simulation logs beside them are tracked.
benchmark/data/genomes/**/*.fna
benchmark/data/protein/**/concat_alignment.faa
benchmark/data/dna/**/aln.phy
benchmark/data/dna/**/aln.log
benchmark/data/.zenodo/

# --- Zenodo staging area (built by benchmark/scripts/dev/zenodo_deposit_benchmark_data.py; never committed) ---
zenodo_upload_bundle/

# --- local archive of material removed from the published benchmark (not distributed) ---
benchmark/xx_archive_junkyard/
# Arial TrueType files for the figures: Monotype-licensed, placed locally, never distributed
benchmark/figures/arial/

# --- manuscript drafts and audit feedback: never published ---
xx_manuscript_drafts/
