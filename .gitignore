# --- build outputs (regenerate with build_iqtree_gpu.sh) ---
iqtree3_gpu_build/
iqtree3_build/
.iqtree3_src/
build_graphs/
*.o
*.so
core.*

# --- cluster logs and job scratch ---
# '/*' rather than a bare directory rule: git cannot re-include a file inside an excluded
# directory, and logs/.gitkeep must stay tracked because slurmd opens a job's -o/-e file before
# the batch script can create the directory.
logs/*
!logs/.gitkeep
*.log
*.err

# --- python caches, editor and OS cruft ---
**/__pycache__/
*.pyc
.DS_Store
*.swp
/.quarto/
**/*.quarto_ipynb

# --- per-user site configuration (config/site.env.example is the tracked fallback) ---
config/site.env

# --- user-generated output from the worked example (expected_output/ IS tracked) ---
examples/out/

# --- transient per-run scratch from the benchmark and validation harnesses ---
# Produced fresh by every run (nvidia-smi samples, wall-clock stamps, raw stdout). Only the
# aggregated RESULT.tsv and the equivalence summaries are worth keeping.
*.util
*.wall
*.time
*.sitelh
results/benchmarks/gpu_validation/
results/benchmarks/gpu_engagement/
results/validation/differential/
results/benchmarks/_snapshots/
results/benchmarks/_archived_pre_mtgpu_*/
results/benchmarks/matrix/*/
# raw Nsight Systems profiles exceed 100 MB; the reduced summary TSV is tracked
results/profiling/*.nsys-rep

# --- bulky IQ-TREE per-run intermediates ---
# Each benchmark cell keeps RESULT.tsv, PHASES.tsv, equivalence.kv, both arms' trees, .iqtree
# reports and run logs; everything regenerable is dropped.
results/**/*.ckp.gz
results/**/*.ufboot
results/**/*.splits.nex
results/**/*.contree
results/**/*.model.gz
results/**/*.mldist
results/**/*.bionj
results/**/*.stdout
results/**/*.parstree
results/**/*.treefile
results/**/*.iqtree
results/**/*.uniqueseq.phy
results/**/core.*
!results/benchmarks/paired/**/*.treefile
!results/benchmarks/paired/**/*.iqtree
!results/benchmarks/paired/**/*.contree
!results/benchmarks/paired/**/*.log
!results/validation/equivalence/**

# --- input data (see data/README.md) ---
# Amino-acid alignments (data/protein/) and the twelve small simulated DNA sets are ordinary
# tracked files. The 14 large simulated DNA alignments (24-382 MB each, ~2.4 GB) exceed GitHub's
# 100 MB per-file limit; they are regenerated byte-identically by
# scripts/dev/build_complexity_datasets.sh from the recipe in each set's PROVENANCE.md, and the
# guide tree that recipe needs is kept.
data/dna/dna_[phu]*_*/aln.phy
data/dna/dna_[phu]*_*/aln.log
!data/dna/dna_[phu]*_*/aln.treefile
# Raw source genomes (data/genomes/**/*.fna, 435 files, ~830 MB) go through Git LFS: .gitattributes

# --- Zenodo staging area (built by scripts/dev/build_zenodo_bundle.sh; never committed) ---
zenodo_upload_bundle/
