# =============================================================================
#  config/site.env.example -- cluster/site-specific settings for IQ-TREE3-GPU.
# =============================================================================
#  HOW THIS IS USED
#    scripts/lib/paths.sh sources the FIRST of these that exists:
#       1. $SITE_ENV                  (explicit override, any path)
#       2. <repo>/config/site.env   (your copy -- gitignored, never committed)
#       3. <repo>/config/site.env.example   <-- this file, the tracked fallback
#
#    Because this file is the fallback, an unconfigured checkout still works: the defaults below
#    reproduce the HMS O2 environment on which every row in results/benchmarks/RUNS.tsv was
#    measured. To adapt the repository to your own machine, copy it and edit:
#
#       cp config/site.env.example config/site.env
#
#  Every value is written as ${VAR:-default}, so anything already exported in your environment
#  wins over what is written here.
# =============================================================================

# --- Where the IQ-TREE binaries live ----------------------------------------------------------
# IQTREE_BUILD_ROOT is the directory CONTAINING the two build trees:
#     $IQTREE_BUILD_ROOT/iqtree3_gpu_build/iqtree3   <- the GPU-enabled binary
#     $IQTREE_BUILD_ROOT/iqtree3_build/iqtree3       <- the stock CPU binary
#
# The default is the repository itself, which is where build_iqtree_gpu.sh puts its output, so a fresh
# checkout that has been built needs no configuration here at all.
#
# The CPU arm needs a stock (non-GPU) IQ-TREE 3 build as well, and build_iqtree_gpu.sh does NOT
# produce one. Either install iqtree3 on PATH or point IQTREE_CPU_BIN at a build directly; the
# paired benchmark is the only thing that needs it, and it reports a clear error if it is missing.
IQTREE_BUILD_ROOT="${IQTREE_BUILD_ROOT:-$REPO}"

# Either binary can be overridden outright, bypassing IQTREE_BUILD_ROOT entirely:
# IQTREE_GPU_BIN="${IQTREE_GPU_BIN:-/path/to/iqtree3}"
# IQTREE_CPU_BIN="${IQTREE_CPU_BIN:-/path/to/stock/iqtree3}"

# Isolated development builds used only by scripts/dev/ (safe to leave unset).
IQTREE_GRAPHS_BUILD="${IQTREE_GRAPHS_BUILD:-$REPO/build_graphs}"

# Header-only dependencies for build_iqtree_gpu.sh / the fresh-build acceptance test.
# DELIBERATELY EMPTY. These used to default to $IQTREE_BUILD_ROOT/deps/..., a directory that exists
# in no checkout, and because paths.sh exports them the build script forwarded a bogus
# -DEIGEN3_INCLUDE_DIR to CMake and silently disabled its own auto-detection. Set them only if
# CMake cannot find your system copies.
EIGEN3_INCLUDE_DIR="${EIGEN3_INCLUDE_DIR:-}"
Boost_INCLUDE_DIR="${Boost_INCLUDE_DIR:-}"

# --- Scheduler --------------------------------------------------------------------------------
# Partitions must be NON-PREEMPTIBLE: a requeued job would restart the clock and silently corrupt
# a wall-time measurement. On O2 both `gpu` and `gpu_quad` are PreemptMode=OFF.
SLURM_PARTITION="${SLURM_PARTITION:-gpu}"
SLURM_GRES="${SLURM_GRES:-gpu:l40s:1}"

# Lmod modules loaded before building or running. gcc MUST come before cuda so the CUDA module
# resolves against the right host compiler (nvcc rejects a GCC newer than it supports).
SLURM_MODULES="${SLURM_MODULES:-gcc/14.2.0 cuda/12.8}"

# Set to 1 on a machine with no module system; the scripts then skip `module load` entirely.
NO_LMOD="${NO_LMOD:-0}"

# --- Profilers --------------------------------------------------------------------------------
# Used only by scripts/benchmark/roofline_profile.sh and nsys_kernel_time.sh. Both are
# taken from PATH by default; set these if your CUDA toolkit is not on PATH.
NCU_BIN="${NCU_BIN:-}"
NSYS_BIN="${NSYS_BIN:-}"
