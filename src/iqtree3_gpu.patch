-        processDervMCMCTree(gradient_vector_new, nBranches, mem_size, G_matrix_new, ptn_freq_diagonal,
-                            gradient_vector_eigen, hessian, hessian_diagonal_new);
+        bool hessian_done = false;
+#ifdef IQTREE_GPU
+        // IQ-TREE3-GPU. Under -gpu the per-pattern derivative matrix G is DEVICE-RESIDENT: each
+        // row was written by the derivative kernel from the register it already held. The
+        // Hessian is then a symmetric rank-k update of it, so it is one cuBLAS DSYRK on the
+        // card instead of a branchNum x mem_size host transpose plus an Eigen product (for the
+        // largest benchmark genus that transpose alone is a ~158 MB temporary).
+        //
+        // gpuMCMCHessian() returns false unless the device G is this tree's, complete and
+        // error-free, in which case nothing below changes and the Eigen path runs exactly as
+        // it always did -- the host G_matrix is filled from the same device rows either way.
+        //
+        // It hands back G*diag(ptn_freq)*G^T indexed by BRANCH ID, unnegated and with its true
+        // diagonal. The three steps processDervMCMCTree() applies on top are reproduced here
+        // rather than shared, because the row permutation into export order has to be applied
+        // to BOTH indices and that is only meaningful on the square matrix.
+        if (branch_ids.size() == nBranches && nBranches == (size_t)tree->branchNum) {
+            vector<double> gpu_hessian(nBranches * nBranches);
+            if (tree->gpuMCMCHessian(gpu_hessian.data(), (int)nBranches)) {
+                gradient_vector_eigen = Map<RowVectorXd>(gradient_vector_new, nBranches);
+                hessian.resize(nBranches, nBranches);
+                for (size_t i = 0; i < nBranches; i++)
+                    for (size_t j = 0; j < nBranches; j++)
+                        hessian(i, j) = -gpu_hessian[(size_t)branch_ids[i] * nBranches
+                                                     + (size_t)branch_ids[j]];
+                hessian.diagonal() = Map<VectorXd>(hessian_diagonal_new, nBranches).array();
+                hessian_done = true;
+                cout << "[IQ-TREE3-GPU] MCMCTree Hessian formed on the device "
+                        "(cuBLAS DSYRK over the resident G matrix)." << endl;
+            }
+        }
+#endif
+        if (!hessian_done)
+            processDervMCMCTree(gradient_vector_new, nBranches, mem_size, G_matrix_new, ptn_freq_diagonal,
+                                gradient_vector_eigen, hessian, hessian_diagonal_new);
         saveTreeMCMCTree(branchLengthsNew, branch_lengths_vector, tree, tree_stream);
 
         aligned_free(G_matrix_new);
diff --git a/tree/CMakeLists.txt b/tree/CMakeLists.txt
index b120155..1eed751 100644
--- a/tree/CMakeLists.txt
+++ b/tree/CMakeLists.txt
@@ -59,3 +59,20 @@ phylohmm.h
 )
 
 target_link_libraries(tree pll model alignment)
+
+# ---- IQ-TREE3-GPU: GPU likelihood backend ----
+if (IQTREE_GPU)
+    target_sources(tree PRIVATE gpu_kernels.cu phylotreegpu.cpp)
+    # -fmad=false: never let the compiler silently contract a*b+c. Every place a fused
+    # multiply-add is wanted calls fma() explicitly, which is what the CPU kernel's mul_add()
+    # does, so rounding stays predictable instead of depending on nvcc's contraction choices.
+    set_source_files_properties(gpu_kernels.cu PROPERTIES LANGUAGE CUDA
+                                COMPILE_OPTIONS "-fmad=false")
+    # CUDA::cublas is required, not optional: gpu_kernels.cu forms the MCMCTree Hessian
+    # H = G*diag(ptn_freq)*G^T with a single cublasDsyrk. Without this line the CUDA
+    # translation unit still COMPILES (cublas_v2.h is on the CUDAToolkit include path that
+    # CUDA::cudart brings in) and only fails at link time, which is exactly the kind of
+    # breakage a fresh clone discovers and a warm build tree does not.
+    target_link_libraries(tree CUDA::cudart CUDA::cublas)
+endif()
+# --------------------------------------------
