+// IQ-TREE3-GPU: GPU likelihood backend entry point.
+//
+// WHY THIS IS A WRAPPER. setLikelihoodKernelCPU() (above) returns early from several branches --
+// on any CPU with SSE2 or better it installs the SIMD pointers and returns immediately. A GPU
+// pointer swap placed at the END of that function, after those returns, would be DEAD CODE: a
+// `-gpu` run would report the CUDA device, pass the device self-test (which calls the device
+// log-likelihood directly, bypassing the function pointers), and then silently run the stock CPU
+// kernel for the entire search. Doing the swap here, after the CPU selection has fully finished,
+// guarantees it applies no matter which branch installed the CPU pointers.
+void PhyloTree::setLikelihoodKernel(LikelihoodKernel lk) {
+    setLikelihoodKernelCPU(lk);
+
+#ifdef IQTREE_GPU
+    // `-gpu` activates the backend when a CUDA device is present.
+    // (Legacy: env IQTREE_GPU_SWAP still forces it on, for reproducing older validation runs.)
+    if (params && (params->gpu_lik || getenv("IQTREE_GPU_SWAP"))) {
+        // THE OUTPUT GUARD, and it comes FIRST -- before the device is even looked at.
+        //
+        // Everything else about GPU selection asks whether the INPUTS are supported. This asks
+        // whether the OUTPUTS this run will consume are ones the engine fills. That question was
+        // never asked, which is how `--dating mcmctree` ran against a G_matrix the GPU had never
+        // written: the buffer existed, held whatever aligned_alloc returned, and the exported
+        // Hessian looked like numbers. gpu_eligible() could not have caught it, because nothing
+        // about the alignment or the model was wrong.
+        //
+        // It runs ahead of the device-count test on purpose. The user asked for -gpu together
+        // with a feature the GPU cannot serve; that is worth saying whether or not a card
+        // happens to be visible, and saying it in the same place every time makes the message
+        // reproducible on a login node.
+        const char *unsupported = iqtree_gpu_unsupported_output(params);
+        if (unsupported) {
+            // --gpu-strict promised that this run is a GPU measurement. Declining the backend
+            // here would produce a pure CPU run that still says "-gpu" on its command line,
+            // which is exactly the confusion the flag exists to prevent.
+            if (params->gpu_strict) {
+                fflush(stdout);
+                outError(string("IQ-TREE3-GPU --gpu-strict: the GPU backend cannot serve this "
+                                "run because ") + unsupported +
+                         ". Plain -gpu would fall back to the CPU kernel for the whole run; "
+                         "--gpu-strict refuses so that the result is not reported as a GPU one.");
+            }
+            static bool gpu_output_guard_done = false;
+            if (!gpu_output_guard_done) {
+                gpu_output_guard_done = true;
+                printf("[IQ-TREE3-GPU] -gpu declined: %s.\n", unsupported);
+                printf("[IQ-TREE3-GPU]   Running on the CPU likelihood kernel instead. "
+                       "Remove the flag above to use the GPU.\n");
+                fflush(stdout);
+            }
+        } else if (iqtree_gpu_device_count() > 0) {
+            // Save CPU pointers so GPU functions can fall back per-call on ineligible models.
+            cpuComputePartialLikelihoodPointer    = computePartialLikelihoodPointer;
+            cpuComputeLikelihoodBranchPointer     = computeLikelihoodBranchPointer;
+            cpuComputeLikelihoodDervPointer       = computeLikelihoodDervPointer;
+            cpuComputeLikelihoodFromBufferPointer = computeLikelihoodFromBufferPointer;
+            computePartialLikelihoodPointer    = &PhyloTree::computePartialLikelihoodGPU;
+            computeLikelihoodBranchPointer     = &PhyloTree::computeLikelihoodBranchGPU;
+            computeLikelihoodDervPointer       = &PhyloTree::computeLikelihoodDervGPU;
+            computeLikelihoodFromBufferPointer = &PhyloTree::computeLikelihoodFromBufferGPU;
+            // NOTE: computeLikelihoodDervMixlenPointer is deliberately left alone. Mixlen trees
+            // are GPU-ineligible (they read the host theta_all, which the GPU path does not
+            // maintain), so they must keep their CPU mixlen derivative; nulling it here used to
+            // turn any -mixlen run under -gpu into a null-pointer call.
+            // ModelFinder re-selects the kernel once per candidate model (~1232 times), so the
+            // banner is printed only on the first activation to keep the log readable.
+            static bool gpu_banner_done = false;
+            if (!gpu_banner_done) {
+                gpu_banner_done = true;
+                // One host thread drives the GPU: each node is a single launch covering ALL
+                // patterns, so -T only affects the CPU-side work (parsimony, model setup).
+                // Splitting the pattern range across host threads and streams, as the previous
+                // integration did, fragments those launches and costs more than it buys.
+                printf("[IQ-TREE3-GPU] GPU acceleration ACTIVE on %s "
+                       "(one launch per node over all patterns, single host thread).\n",
+                       iqtree_gpu_device_name());
+                printf("[IQ-TREE3-GPU]   accelerated: single-matrix reversible models with "
+                       "+F, +G, +R, +I -- amino acid (LG/WAG/VT/JTT/Q.*) and "
+                       "nucleotide (JC/K80/HKY/TN/GTR and the rest of the reversible DNA set).\n");
+                printf("[IQ-TREE3-GPU]   CPU fallback (per call): mixture/profile, non-reversible, "
+                       "+ASC, +E, mixlen, partitioned, and codon/morphological/binary data.\n");
+                // Informational only. This run is a single GPU analysis; nothing is run on the
+                // CPU and nothing is compared. The agreement with CPU IQ-TREE was established
+                // separately, and the two scripts named here are the user's OPTIONAL checks.
+                printf("[IQ-TREE3-GPU]   This is one analysis on the GPU; no CPU run is made and nothing "
+                       "is compared. Validated against CPU IQ-TREE (RF=0, logL within 1e-4, matching "
+                       "support); optional checks: scripts/iqtree3-gpu-verify.sh, "
+                       "scripts/iqtree3-gpu-benchmark.sh.\n");
+                // The banner above is printed ONCE and proves nothing about the rest of the
+                // run: every entry point re-tests eligibility per call and can delegate
+                // silently. Point at the accounting that does prove it.
+                printf("[IQ-TREE3-GPU]   Per-call accounting is reported at exit as "
+                       "'likelihood calls: N on GPU, M delegated to CPU' plus a GPUSTATS line; "
+                       "--gpu-strict turns any delegation into an error.\n");
+                if (params->gpu_strict)
+                    printf("[IQ-TREE3-GPU]   --gpu-strict ACTIVE: identical kernels and "
+                           "identical results to plain -gpu; the only difference is that a CPU "
+                           "fallback or a device error aborts the run instead of being "
+                           "absorbed.\n");
+                // Where the branch-length Newton loop runs is a run-constant choice that
+                // changes device-call counts and timings, so it is stated up front with the
+                // other run-constant facts and repeated as newton_mode= in the GPUSTATS line.
+                printf("[IQ-TREE3-GPU]   branch-length Newton loop: %s\n",
+                       params->gpu_newton_device
+                           ? "on the device (--gpu-newton device; opt-in, not the benchmarked configuration)"
+                           : "on the host with device-evaluated derivatives (--gpu-newton host, the default; the benchmarked configuration)");
+                if (params->dating_method == "mcmctree") {
+                    // Named explicitly because it is the feature that motivated the output
+                    // guard: saying "supported" out loud is what distinguishes a checked case
+                    // from an unchecked one in a log a reviewer reads a year from now.
+                    printf("[IQ-TREE3-GPU]   --dating mcmctree: gradients, Hessian diagonal and "
+                           "the per-pattern G matrix are produced on the device (Hessian via "
+                           "cuBLAS DSYRK).\n");
+                }
+                fflush(stdout);
+            }
+        } else {
+            // Same argument as the output guard above: no device means the whole run is CPU,
+            // and --gpu-strict exists so that such a run cannot be mistaken for a GPU one.
+            if (params->gpu_strict) {
+                fflush(stdout);
+                outError("IQ-TREE3-GPU --gpu-strict: no CUDA device is visible. Plain -gpu falls "
+                         "back to the CPU kernel here; --gpu-strict refuses, because the run "
+                         "would otherwise be a CPU run reported under a -gpu command line.");
+            }
+            static bool gpu_nodev_done = false;
+            if (!gpu_nodev_done) {
+                gpu_nodev_done = true;
+                printf("[IQ-TREE3-GPU] -gpu requested but no CUDA device is visible; using the CPU kernel.\n");
+                fflush(stdout);
+            }
+        }
+    }
+#endif
 }
 
